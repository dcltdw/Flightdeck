<resources>
    <settings>
        <setting propertyKey="@Properties.theme" title="@Strings.SettingTheme">
            <settingConfig type="list">
                <listEntry value="0">@Strings.ThemeCockpit</listEntry>
                <listEntry value="1">@Strings.ThemeBridge</listEntry>
                <listEntry value="2">@Strings.ThemeWall</listEntry>
                <listEntry value="3">@Strings.ThemePhosphor</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.mode" title="@Strings.SettingMode">
            <settingConfig type="list">
                <listEntry value="0">@Strings.ModeDark</listEntry>
                <listEntry value="1">@Strings.ModeLight</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
